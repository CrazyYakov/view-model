{
    "name": "rkov/view-model",
    "description": "View models for REST API \u2014 create model representations using dependency injection",
    "type": "library",
    "keywords": [
        "view-model",
        "resource",
        "api",
        "rest",
        "json",
        "transformer",
        "rkov"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Rochev Yakov",
            "email": "gitarar98@yanex.ru"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.0",
        "friendsofphp/php-cs-fixer": "^3.40",
        "phpstan/phpstan-deprecation-rules": "^1.1",
        "phpstan/phpstan-strict-rules": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Rkov\\ViewModel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rkov\\ViewModel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=256M",
        "phpunit": "phpunit",
        "cs-fix": "php-cs-fixer fix --dry-run --diff",
        "qa": [
            "@phpstan",
            "@phpunit",
            "@cs-fix"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
